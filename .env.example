# 复制为 .env 后填写。不要把真实密钥提交到仓库。
# 开发环境保持 PRODUCT_AUTH 为空或 0，现有控制台可以匿名使用。
# APP_ENV=production 时必须开启 PRODUCT_AUTH，并设置独立 TOKEN_SECRET，否则服务拒绝启动。

APP_ENV=development
PRODUCT_AUTH=
TOKEN_SECRET=
# 生产环境改为明确来源，不能是 *
CORS_ORIGINS=http://127.0.0.1:9621
# 仅在 HTTPS 部署时设为 1。本机 http 保持关闭，否则浏览器不会保存登录 Cookie。
COOKIE_SECURE=
# 把旧的 local-owner 知识库交给这个已注册邮箱。不设置则不会自动转移。
PRODUCT_OWNER_EMAIL=
AUTH_RATE_LIMIT=8
MAX_UPLOAD_MB=20
MAX_FILES_PER_KB=100
MAX_PDF_PAGES=200
UPLOAD_TIMEOUT_MINUTES=30
# 开发留空则使用 WORKING_DIR/product_jobs.sqlite。生产 Worker 必须是 postgresql://，密码不要写进仓库。
DATABASE_URL=
WORKER_COUNT=1
WORKER_POLL_INTERVAL=1
JOB_LEASE_SECONDS=30
JOB_HEARTBEAT_SECONDS=10
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BACKOFF=2
MAX_CONCURRENT_JOBS_PER_USER=2
MAX_CONCURRENT_JOBS_PER_KB=2
# Phase C1 半双工语音练习。留空时接口明确返回“服务尚未配置”，不会伪造转写或音频。
ASR_API_BASE=
ASR_API_KEY=
ASR_MODEL=
TTS_API_BASE=
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=alloy
VOICE_TIMEOUT_SECONDS=60
VOICE_MAX_AUDIO_MB=25
# 目标存储。三套系统用同一套 user_id、kb_id、doc_id、chunk_id、entity_id、relation_id、source_id 互相定位。
# Neo4j 管图谱和多跳，Milvus 管文本块、实体、关系的向量召回，PostgreSQL 管正文和来源对照。
# 在 Neo4j、Milvus、PostgreSQL 都可用之前，保持下面的默认值，不要改正在运行的 9621。
# GRAPH_STORAGE=Neo4jStorage
# VECTOR_STORAGE=MilvusVectorDBStorage
# KV_STORAGE=PGKVStorage
